# Database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=muchocore
DB_USER=muchocore_user
DB_PASS=change-me

# Optional Geometry Dash endpoint overrides
# MUCHO_ACCOUNT_URL=https://example.com
# MUCHO_CUSTOM_CONTENT_URL=https://example.com/content
#
# Reverse proxy trust and download deduplication
# Keep the proxy list empty unless a reverse proxy is actually in front of PHP.
MUCHO_TRUSTED_PROXIES=
MUCHO_DOWNLOAD_DEDUP_SECONDS=300

