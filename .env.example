# Database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=muchocore
DB_USER=muchocore_user
DB_PASS=change-me

# Optional Geometry Dash endpoint overrides
# MUCHO_ACCOUNT_URL=https://example.com
# MUCHO_CUSTOM_CONTENT_URL=https://example.com/content

# Account recovery
# Use the public HTTPS origin of your GDPS.
# MUCHO_PUBLIC_URL=https://example.com
# Sender address used by PHP mail().
# MUCHO_RECOVERY_FROM=no-reply@example.com

# MuchoProtect
# Enabled by default. Set to 0/off to disable request protection.
MUCHO_PROTECT=1
# Optional private runtime directory for protection audit events.
# MUCHO_PROTECT_AUDIT_DIR=/tmp/muchocore-protect
# Optional private runtime directory for temporary abuse penalties.
# MUCHO_PROTECT_PENALTY_DIR=/tmp/muchocore-protect-penalties
