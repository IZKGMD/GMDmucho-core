# ============================================================
# MuchoCore — простые настройки
# Меняй только значения справа от '='.
# 1 = включено, 0 = выключено.
# ============================================================

MUCHO_SERVER_NAME=MuchoGDPS
MUCHO_SERVER_VERSION=1.0.1
MUCHO_REGISTRATION_ENABLED=1
MUCHO_LEVEL_UPLOAD_ENABLED=1
MUCHO_CLOUD_SAVE_MAX_MB=32
MUCHO_LEVEL_MAX_MB=32
MUCHO_CUSTOM_CONTENT_URL=https://geometrydashfiles.b-cdn.net

# ============================================================
# Служебные настройки БД. Обычно их не нужно менять.
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=muchocore
DB_USER=muchocore_user
DB_PASS=change-me

# MUCHO_ACCOUNT_URL=https://example.com
