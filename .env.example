# Geometry Dash compatibility profile
# all = GD 1.9, 2.0, 2.1 and 2.2
# Or a comma-separated subset, e.g. 19,22
MUCHO_GD_VERSIONS=all

# Automatic VPS updates
# Enabled by default. Automatic updates use published stable GitHub Releases.
MUCHO_AUTO_UPDATE=1
MUCHO_AUTO_UPDATE_INTERVAL=15min

# Custom plugin system
# Enabled by default. Plugins are loaded from custom/plugins/.
MUCHO_PLUGINS_ENABLED=1
# Optional custom plugin directory override.
# MUCHO_PLUGIN_DIR=/opt/muchocore/custom/plugins

# Database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=muchocore
DB_USER=muchocore_user
DB_PASS=change-me

# WebAuthn / Passkey login for the Admin Panel
# The RP ID must be the domain serving the admin panel, e.g. muchogdps.space.
# Leave unset to derive it from MUCHO_PUBLIC_URL, MUCHO_ACCOUNT_URL or DOMAIN.
# MUCHO_ADMIN_PASSKEY_RP_ID=muchogdps.space

# Optional Geometry Dash endpoint overrides
# MUCHO_ACCOUNT_URL=https://example.com
# MUCHO_CUSTOM_CONTENT_URL=https://example.com/content

# Account recovery
# Use the public HTTPS origin of your GDPS.
# MUCHO_PUBLIC_URL=https://example.com
# Sender address used by PHP mail().
# MUCHO_RECOVERY_FROM=no-reply@example.com

# MuchoProtect
# Enabled by default. Set to 0/off to disable request protection.
MUCHO_PROTECT=1
# Security-first default: rate-limit storage failures block requests.
# Set to 1 only as an explicit emergency availability override.
# MUCHO_PROTECT_FAIL_OPEN=0
# Optional private runtime directory for protection audit events.
# MUCHO_PROTECT_AUDIT_DIR=/tmp/muchocore-protect
# Optional private runtime directory for temporary abuse penalties.
# MUCHO_PROTECT_PENALTY_DIR=/tmp/muchocore-protect-penalties
