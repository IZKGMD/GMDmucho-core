Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Real files and directories are served normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# All Geometry Dash compatibility routes go through the front controller.
RewriteRule ^ index.php [QSA,END]
