from typing import Callable, Mapping, Any

class _Events:
    def on(self, event: str) -> Callable[[Callable[[Mapping[str, Any]], None]], Callable[[Mapping[str, Any]], None]]: ...
class _UI:
    def notice(self, message: str) -> None: ...
    def button(self, button_id: str, title: str, callback: Callable[[], None]) -> None: ...
class _Effects:
    def pulse(self, color: str = ..., duration: float = ..., opacity: int = ...) -> None: ...
events: _Events
ui: _UI
effects: _Effects
def log(message: str) -> None: ...
