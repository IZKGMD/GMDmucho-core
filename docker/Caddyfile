{$DOMAIN} {
    root * /var/www/mucho-core/public
    encode gzip zstd

    header {
        X-MuchoCore-Copyright "Copyright (C) 2026 IZK"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Copyright (C) 2026 IZK

    # Keep private project files unreachable, but do not block /database/*:
    # Geometry Dash client endpoints live under /public/database.
    @hidden path /.env /.git/* /composer.json /composer.lock /config/* /src/* /tests/*
    respond @hidden 404

    # The public landing page is static HTML and must win over the PHP front controller.
    @site path / /index.html
    handle @site {
        file_server
    }

    handle {
        php_fastcgi app:9000
        file_server
    }
}
