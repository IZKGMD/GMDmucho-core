{
    # Keep legacy Geometry Dash 1.9 HTTP clients on plain HTTP.
    # HTTPS remains enabled explicitly below; HTTP is never redirected to HTTPS.
    auto_https disable_redirects
}

{$CADDY_ADDRESS} {
    root * /var/www/mucho-core/public
    encode gzip zstd

    # The public MuchoCore product/AI discovery pages belong only to the
    # explicitly configured canonical project host. Other GDPS tenants use
    # the same application source but must never expose this marketing/docs
    # surface.
    @muchocore_private_noncanonical {
        not host {$MUCHOCORE_SITE_HOST}
        path /muchocore /muchocore/* /llms.txt /sitemap.xml /robots.txt
    }
    handle @muchocore_private_noncanonical {
        respond 404
    }

    # Main MuchoGDPS landing page. Only the canonical project host
    # serves the marketing homepage; tenant GDPS hosts keep the API front controller.
    @muchogdps_home {
        host {$MUCHOCORE_SITE_HOST}
        path /
    }
    handle @muchogdps_home {
        rewrite * /index.html
        file_server
    }

    # Canonical homepage: / is the only public landing-page URL.
    # Redirect legacy /index and /index/ requests to the root.
    @muchogdps_index {
        host {$MUCHOCORE_SITE_HOST}
        path /index /index/
    }
    redir @muchogdps_index / 308

    # Serve the MuchoCore product page explicitly. Do not rely on the
    # application/PHP fallback for this static discovery surface.
    @muchocore_root {
        host {$MUCHOCORE_SITE_HOST}
        path /muchocore
    }
    handle @muchocore_root {
        redir /muchocore /muchocore/ 308
    }

    @muchocore_page {
        host {$MUCHOCORE_SITE_HOST}
        path /muchocore/*
    }
    handle @muchocore_page {
        uri strip_prefix /muchocore
        root * /var/www/mucho-core/public/muchocore
        file_server
    }

    # Reject oversized HTTP bodies before PHP is invoked. PHP itself remains
    # capped at 70M post_max_size / 64M upload_max_filesize.
    request_body {
        max_size 75MB
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Legacy dashboard favicon path; keep the URL stable while using the
    # canonical generated MuchoCore logo asset.
    handle /assets/muchocore-dashboard-logo.jpg {
        root * /var/www/mucho-core/public
        rewrite * /assets/muchocore-logo.jpg
        file_server
    }

    # Custom uploaded music lives outside public/ and is exposed only through
    # this explicit, read-only /music/ path.
    handle_path /music/* {
        root * /var/www/mucho-core/storage/music-public
        file_server
    }

    # Android client releases are stored outside public/ and exposed only
    # through this explicit, read-only download path.
    handle_path /downloads/android/* {
        root * /var/www/mucho-core/releases/android
        file_server
    }

    # Geometry Dash 1.9 opens these legacy account-recovery URLs.
    # Keep the original paths and serve the unified MuchoCore recovery flow.
    @legacy_recovery path /GD/accountHelp /GD/accountHelp.php
    handle @legacy_recovery {
        rewrite * /api/api/accounts/lostusername.php
    }

    # The game API remains available over HTTP for legacy clients,
    # but the administrator session must always use HTTPS.
    @admin_http {
        protocol http
        path /admin /admin/*
        # Cloudflare and other TLS-terminating proxies can reach the origin
        # over HTTP while the browser is already on HTTPS. Honor the original
        # scheme marker so those requests are not redirected back into a loop.
        not header X-Forwarded-Proto https
    }
    redir @admin_http https://{host}{uri} 308

    # The shared-hosting installer is only for non-Docker deployments.
    # Never expose it from the Docker/VPS public site.
    @shared_installer path /shared-install.php
    respond @shared_installer 404

    # Keep private project files unreachable, but do not block /database/*:
    # Geometry Dash client endpoints live under /public/database.
    @hidden path /.env* /.git/* /composer.json /composer.lock /config/* /src/* /tests/* /storage/*
    respond @hidden 404

    php_fastcgi app:9000
    file_server
}
