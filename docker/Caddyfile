{$CADDY_ADDRESS} {
    root * /var/www/mucho-core/public
    encode gzip zstd

    # Reject oversized HTTP bodies before PHP is invoked. PHP itself remains
    # capped at 70M post_max_size / 64M upload_max_filesize.
    request_body {
        max_size 75MB
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    handle /assets/muchocore-dashboard-logo.jpg {
        root * /var/www/mucho-core
        rewrite * /Gemini_Generated_Image_vemzsvemzsvemzsv.jpg
        file_server
    }

    handle /assets/muchocore-source.jpg {
        root * /var/www/mucho-core
        rewrite * /Gemini_Generated_Image_af007baf007baf00.jpg
        file_server
    }

    # MuchoCore brand fallback: serve the uploaded source logo until the
    # optimized public/assets variant has been generated.
    handle /assets/muchocore-logo.jpg {
        root * /var/www/mucho-core
        try_files /public/assets/muchocore-logo.jpg /Gemini_Generated_Image_af007baf007baf00.jpg
        file_server
    }

    # Custom uploaded music lives outside public/ and is exposed only through
    # this explicit, read-only /music/ path.
    handle_path /music/* {
        root * /var/www/mucho-core/storage/music-public
        file_server
    }

    # Keep private project files unreachable, but do not block /database/*:
    # Geometry Dash client endpoints live under /public/database.
    @hidden path /.env /.git/* /composer.json /composer.lock /config/* /src/* /tests/* /storage/*
    respond @hidden 404

    php_fastcgi app:9000
    file_server
}
