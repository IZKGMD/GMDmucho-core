:80 {
    root * /var/www/mucho-core/public
    encode gzip zstd

    request_body {
        max_size 75MB
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }

    # Match the production song-file route. PHP metadata alone cannot
    # certify that old GD clients will receive the MP3 bytes.
    handle_path /music/* {
        root * /var/www/mucho-core/storage/music-public
        header Content-Type audio/mpeg
        file_server
    }

    php_fastcgi testgdps-app:9000
    file_server
}
