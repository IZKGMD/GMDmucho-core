#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SECRETS="$ROOT/.secrets"
ENV_FILE="$ROOT/.env"

[[ $EUID -eq 0 ]] || { echo "Run: sudo muchodb-password" >&2; exit 1; }
[[ -s "$SECRETS/db_root_password" ]] || { echo "Database root secret is missing." >&2; exit 1; }
[[ -s "$SECRETS/db_password" ]] || { echo "Database secret is missing." >&2; exit 1; }

db_user="$(sed -n 's/^DB_USER=//p' "$ENV_FILE" | head -n1)"
[[ "$db_user" =~ ^[A-Za-z0-9_]+$ ]] || { echo "Invalid DB_USER." >&2; exit 1; }

read -r -s -p "New database password (leave empty to generate one): " new_password < /dev/tty
printf '\n'
if [[ -z "$new_password" ]]; then
    new_password="$(openssl rand -hex 24)"
    echo "Generated password: $new_password"
fi
read -r -s -p "Confirm database password: " confirm_password < /dev/tty
printf '\n'
[[ "$new_password" == "$confirm_password" ]] || { echo "Passwords do not match." >&2; exit 1; }
[[ "$new_password" =~ ^[A-Za-z0-9._@#%+=:-]{12,128}$ ]] || { echo "Use 12-128 characters from A-Z, a-z, 0-9 and ._@#%+=:-." >&2; exit 1; }

root_password="$(cat "$SECRETS/db_root_password")"

cd "$ROOT"
if [[ -n "$(sed -n 's/^MUCHO_TUNNEL_TOKEN=//p' "$ENV_FILE" | head -n1)" ]]; then
    compose_args=(-f docker-compose.yml -f docker-compose.tunnel.yml)
else
    compose_args=()
fi

escaped_user="${db_user//\'/\'\'}"
escaped_password="${new_password//\'/\'\'}"

docker compose "${compose_args[@]}" exec -T -e MYSQL_PWD="$root_password" db \
    mariadb -uroot -e \
    "ALTER USER '$escaped_user'@'%' IDENTIFIED BY '$escaped_password'; FLUSH PRIVILEGES;"

printf '%s' "$new_password" > "$SECRETS/db_password"
chmod 600 "$SECRETS/db_password"

docker compose "${compose_args[@]}" up -d --force-recreate app >/dev/null

echo "Database password changed and MuchoCore app restarted."
