#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * MuchoCore Administration CLI
 * Copyright (C) 2026 IZK
 */

require dirname(__DIR__) . '/vendor/autoload.php';

use MuchoCore\Account\AccountService;
use MuchoCore\Database\Database;
use MuchoCore\Moderation\ModerationRepository;

function usage(): never
{
    echo <<<TXT
MuchoCore Admin CLI

Commands:
  mucho-admin set-role <ACCOUNT_ID|USERNAME> <user|moderator|admin|owner>
  mucho-admin set-password <ACCOUNT_ID|USERNAME>
  mucho-admin rate-level <LEVEL_ID> <STARS> [FEATURED 0/1] [EPIC 0-3] [DEMON 0-5]
  mucho-admin list-levels

Passwords are entered interactively and never passed in command arguments.

TXT;
    exit(1);
}

function failCli(string $message): never
{
    fwrite(STDERR, "ERROR: {$message}\n");
    exit(1);
}

function promptHidden(string $label): string
{
    fwrite(STDOUT, $label);

    if (function_exists('stream_isatty') && stream_isatty(STDIN)) {
        shell_exec('stty -echo');
        try {
            $value = rtrim((string)fgets(STDIN), "\r\n");
        } finally {
            shell_exec('stty echo');
            fwrite(STDOUT, PHP_EOL);
        }

        return $value;
    }

    return rtrim((string)fgets(STDIN), "\r\n");
}

function promptHiddenTwice(): string
{
    $first = promptHidden("New password: ");
    $second = promptHidden("Repeat password: ");

    if ($first !== $second) {
        failCli('Passwords do not match.');
    }

    if (strlen($first) < 12) {
        failCli('Password must be at least 12 characters.');
    }

    if (strlen($first) > 512) {
        failCli('Password is too long.');
    }

    return $first;
}

function findAccountId(PDO $db, string $target): int
{
    if (ctype_digit($target)) {
        return (int)$target;
    }

    $q = $db->prepare(
        'SELECT account_id
         FROM accounts
         WHERE username = :username
         LIMIT 1'
    );
    $q->execute(['username' => $target]);

    return (int)($q->fetchColumn() ?: 0);
}

function roleId(PDO $db, string $role): int
{
    $q = $db->prepare(
        'SELECT id FROM roles WHERE code = :role LIMIT 1'
    );
    $q->execute(['role' => $role]);

    return (int)($q->fetchColumn() ?: 0);
}

try {
    if (PHP_SAPI !== 'cli') {
        failCli('CLI only.');
    }

    $db = (new Database())->connection();
    $command = (string)($argv[1] ?? '');

    if ($command === 'set-role') {
        $target = trim((string)($argv[2] ?? ''));
        $role = strtolower(trim((string)($argv[3] ?? '')));

        $aliases = [
            'mod' => 'moderator',
            'helper' => 'moderator',
            'elder' => 'moderator',
        ];
        $role = $aliases[$role] ?? $role;

        if ($target === '' || !in_array($role, ['user', 'moderator', 'admin', 'owner'], true)) {
            usage();
        }

        $accountId = findAccountId($db, $target);
        if ($accountId <= 0) {
            failCli('Account not found.');
        }

        $roleId = roleId($db, $role);
        if ($roleId <= 0) {
            failCli('Role is not installed.');
        }

        $q = $db->prepare(
            'UPDATE accounts
             SET role_id = :role_id
             WHERE account_id = :account_id'
        );
        $q->execute([
            'role_id' => $roleId,
            'account_id' => $accountId,
        ]);

        echo "ROLE_SET_OK\n";
        exit;
    }

    if ($command === 'set-password') {
        $target = trim((string)($argv[2] ?? ''));

        if ($target === '') {
            usage();
        }

        $accountId = findAccountId($db, $target);
        if ($accountId <= 0) {
            failCli('Account not found.');
        }

        $password = promptHiddenTwice();
        $passwordHash = password_hash($password, PASSWORD_DEFAULT);
        $gjp2 = sha1($password . AccountService::GJP2_SALT);
        $gjp2Hash = password_hash($gjp2, PASSWORD_DEFAULT);

        $q = $db->prepare(
            'UPDATE accounts
             SET password_hash = :password_hash,
                 gjp2_hash = :gjp2_hash
             WHERE account_id = :account_id'
        );
        $q->execute([
            'password_hash' => $passwordHash,
            'gjp2_hash' => $gjp2Hash,
            'account_id' => $accountId,
        ]);

        echo "PASSWORD_SET_OK\n";
        exit;
    }

    if ($command === 'rate-level') {
        $levelId = (int)($argv[2] ?? 0);
        $stars = (int)($argv[3] ?? 0);
        $featured = (int)($argv[4] ?? 0);
        $epic = (int)($argv[5] ?? 0);
        $demon = (int)($argv[6] ?? 0);

        if (
            $levelId <= 0 ||
            $stars < 0 || $stars > 10 ||
            !in_array($featured, [0, 1], true) ||
            $epic < 0 || $epic > 3 ||
            $demon < 0 || $demon > 5
        ) {
            failCli('Invalid rating values.');
        }

        $q = $db->prepare(
            'SELECT account_id
             FROM levels
             WHERE level_id = :level_id
             LIMIT 1'
        );
        $q->execute(['level_id' => $levelId]);
        $authorId = (int)($q->fetchColumn() ?: 0);

        if ($authorId <= 0) {
            failCli('Level not found.');
        }

        if ($epic > 0) {
            $featured = 1;
        }

        if ($demon > 0) {
            $stars = 10;
        }

        $difficulty = match (true) {
            $demon > 0 => 50,
            $stars === 0 => 0,
            $stars === 1 => 50,
            $stars === 2 => 10,
            $stars === 3 => 20,
            $stars <= 5 => 30,
            $stars <= 7 => 40,
            $stars <= 10 => 50,
            default => 0,
        };

        $demonDifficulty = match ($demon) {
            1 => 3,
            2 => 4,
            3 => 0,
            4 => 5,
            5 => 6,
            default => 0,
        };

        $auto = ($stars === 1 && $demon === 0) ? 1 : 0;
        $isDemon = $demon > 0 || $stars === 10;

        $q = $db->prepare(
            'UPDATE levels
             SET stars = :stars,
                 difficulty = :difficulty,
                 featured = :featured,
                 epic = :epic,
                 demon = :demon,
                 demon_difficulty = :demon_difficulty,
                 auto_level = :auto
             WHERE level_id = :level_id'
        );
        $q->execute([
            'stars' => $stars,
            'difficulty' => $difficulty,
            'featured' => $featured,
            'epic' => $epic,
            'demon' => $isDemon ? 1 : 0,
            'demon_difficulty' => $demonDifficulty,
            'auto' => $auto,
            'level_id' => $levelId,
        ]);

        (new ModerationRepository($db))
            ->recalculateCreatorPoints($authorId);

        echo "RATE_LEVEL_OK\n";
        exit;
    }

    if ($command === 'list-levels') {
        $rows = $db->query(
            'SELECT level_id, name, stars, featured, epic, demon
             FROM levels
             ORDER BY level_id DESC
             LIMIT 10'
        )->fetchAll(PDO::FETCH_ASSOC);

        foreach ($rows as $row) {
            echo '#'.$row['level_id']
                .' | '.$row['name']
                .' | Stars: '.$row['stars']
                .' | Featured: '.$row['featured']
                .' | Epic: '.$row['epic']
                .' | Demon: '.$row['demon']
                .PHP_EOL;
        }

        exit(0);
    }

    usage();
} catch (Throwable $e) {
    failCli($e->getMessage());
}
