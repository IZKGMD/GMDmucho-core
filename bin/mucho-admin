#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use MuchoCore\Account\AccountService;
use PDO;

$root = dirname(__DIR__);
$env = [];

foreach ([
    $root . '/.env',
    $root . '/.env.local',
    '/var/lib/muchocore/runtime.env',
] as $envFile) {
    if (!is_file($envFile)) {
        continue;
    }

    foreach (file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
        $line = trim($line);
        if ($line === '' || str_starts_with($line, '#') || !str_contains($line, '=')) {
            continue;
        }

        [$key, $value] = explode('=', $line, 2);
        $env[trim($key)] = trim($value, " \t\r\n\"'");
    }
}

$dbHost = $env['DB_HOST'] ?? getenv('DB_HOST') ?: '127.0.0.1';
$dbPort = $env['DB_PORT'] ?? getenv('DB_PORT') ?: '3306';
$dbName = $env['DB_NAME'] ?? getenv('DB_NAME') ?: 'muchocore';
$dbUser = $env['DB_USER'] ?? getenv('DB_USER') ?: 'muchocore_user';
$dbPass = $env['DB_PASS'] ?? getenv('DB_PASS') ?: '';

if ($dbPass === '' && is_file('/run/secrets/db_password')) {
    $dbPass = trim((string)file_get_contents('/run/secrets/db_password'));
}

if ($dbPass === '') {
    fwrite(STDERR, "DB credentials are not configured.\n");
    exit(1);
}

try {
    $pdo = new PDO(
        "mysql:host={$dbHost};port={$dbPort};dbname={$dbName};charset=utf8mb4",
        $dbUser,
        $dbPass,
        [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
        ]
    );
} catch (PDOException $e) {
    fwrite(STDERR, "Database connection failed.\n");
    exit(1);
}

function roleCode(string $role): string
{
    return match (strtolower(trim($role))) {
        'player', 'user' => 'user',
        'mod', 'moderator' => 'moderator',
        'elder', 'elder_moderator' => 'elder_moderator',
        'owner' => 'owner',
        default => throw new InvalidArgumentException('Unknown role.'),
    };
}

function setRole(PDO $pdo, string $username, string $role): void
{
    if ($username === '') {
        throw new InvalidArgumentException('Username is required.');
    }

    $role = roleCode($role);

    $roleQuery = $pdo->prepare(
        'SELECT id FROM roles WHERE code=:role LIMIT 1'
    );
    $roleQuery->execute(['role' => $role]);
    $roleId = $roleQuery->fetchColumn();

    if ($roleId === false) {
        throw new RuntimeException('Canonical role not found: ' . $role);
    }

    $update = $pdo->prepare(
        'UPDATE accounts
         SET role_id=:role_id
         WHERE username=:username'
    );
    $update->execute([
        'role_id' => (int)$roleId,
        'username' => $username,
    ]);

    if ($update->rowCount() === 0) {
        $exists = $pdo->prepare(
            'SELECT 1 FROM accounts WHERE username=:username LIMIT 1'
        );
        $exists->execute(['username' => $username]);

        if ($exists->fetchColumn() === false) {
            throw new RuntimeException('Account not found.');
        }
    }

    echo "Role updated for {$username}: {$role}\n";
}

function resetPassword(PDO $pdo, string $username, string $password): void
{
    if ($username === '' || strlen($password) < 8 || strlen($password) > 256) {
        throw new InvalidArgumentException(
            'Password must be 8-256 bytes and username is required.'
        );
    }

    $passHash = password_hash($password, PASSWORD_DEFAULT);
    $gjp2 = sha1($password . AccountService::GJP2_SALT);
    $gjp2Hash = password_hash($gjp2, PASSWORD_DEFAULT);

    $update = $pdo->prepare(
        'UPDATE accounts
         SET password_hash=:password_hash,
             gjp2_hash=:gjp2_hash
         WHERE username=:username'
    );
    $update->execute([
        'password_hash' => $passHash,
        'gjp2_hash' => $gjp2Hash,
        'username' => $username,
    ]);

    if ($update->rowCount() === 0) {
        $exists = $pdo->prepare(
            'SELECT 1 FROM accounts WHERE username=:username LIMIT 1'
        );
        $exists->execute(['username' => $username]);

        if ($exists->fetchColumn() === false) {
            throw new RuntimeException('Account not found.');
        }
    }

    echo "Password updated for {$username}.\n";
}

function rateLevel(PDO $pdo, int $levelId, int $stars, int $featured, int $epic, int $demon): void
{
    if ($levelId <= 0 || $stars < 1 || $stars > 10) {
        throw new InvalidArgumentException('Level ID must be positive and stars must be 1-10.');
    }

    $featured = $featured > 0 ? 1 : 0;
    $epic = max(0, min(3, $epic));
    $demon = max(0, min(6, $demon));

    $difficulty = match ($stars) {
        1, 2 => 10,
        3 => 20,
        4, 5 => 30,
        6, 7 => 40,
        8, 9, 10 => 50,
    };

    $isDemon = $demon > 0 ? 1 : 0;
    $demonDifficulty = $isDemon ? $demon : 0;
    $autoLevel = $stars === 1 ? 1 : 0;

    $stmt = $pdo->prepare(
        'UPDATE levels
         SET stars=:stars,
             difficulty=:difficulty,
             featured=:featured,
             epic=:epic,
             demon=:demon,
             demon_difficulty=:demon_difficulty,
             auto_level=:auto_level
         WHERE level_id=:level_id'
    );
    $stmt->execute([
        'stars' => $stars,
        'difficulty' => $difficulty,
        'featured' => $featured,
        'epic' => $epic,
        'demon' => $isDemon,
        'demon_difficulty' => $demonDifficulty,
        'auto_level' => $autoLevel,
        'level_id' => $levelId,
    ]);

    if ($stmt->rowCount() === 0) {
        $exists = $pdo->prepare(
            'SELECT 1 FROM levels WHERE level_id=:level_id LIMIT 1'
        );
        $exists->execute(['level_id' => $levelId]);

        if ($exists->fetchColumn() === false) {
            throw new RuntimeException('Level not found.');
        }
    }

    /*
     * Recalculate CP from current level state instead of incrementing it on
     * every manual re-rate, which could otherwise inflate creator points.
     */
    $author = $pdo->prepare(
        'SELECT account_id FROM levels WHERE level_id=:level_id LIMIT 1'
    );
    $author->execute(['level_id' => $levelId]);
    $accountId = (int)($author->fetchColumn() ?: 0);

    if ($accountId > 0) {
        $cp = $pdo->prepare(
            'SELECT COALESCE(
                SUM(
                    CASE WHEN stars > 0 THEN 1 ELSE 0 END
                    + CASE WHEN featured > 0 THEN 1 ELSE 0 END
                    + epic
                ),
                0
             )
             FROM levels
             WHERE account_id=:account_id
               AND is_deleted=0'
        );
        $cp->execute(['account_id' => $accountId]);

        $sync = $pdo->prepare(
            'UPDATE profiles
             SET creator_points=:creator_points
             WHERE account_id=:account_id'
        );
        $sync->execute([
            'creator_points' => (int)$cp->fetchColumn(),
            'account_id' => $accountId,
        ]);
    }

    echo "Level #{$levelId} rated: {$stars} stars.\n";
}

function listLevels(PDO $pdo): void
{
    $rows = $pdo->query(
        'SELECT level_id, name, stars, featured, epic, demon
         FROM levels
         ORDER BY level_id DESC
         LIMIT 10'
    )->fetchAll();

    echo "=== Latest levels ===\n";
    foreach ($rows as $row) {
        echo sprintf(
            "#%d | %s | Stars: %d | Featured: %d | Epic: %d | Demon: %d\n",
            (int)$row['level_id'],
            (string)$row['name'],
            (int)$row['stars'],
            (int)$row['featured'],
            (int)$row['epic'],
            (int)$row['demon']
        );
    }
}

$action = $argv[1] ?? '';

try {
    switch ($action) {
        case 'set-password':
            resetPassword(
                $pdo,
                (string)($argv[2] ?? ''),
                (string)($argv[3] ?? '')
            );
            break;

        case 'set-role':
            setRole(
                $pdo,
                (string)($argv[2] ?? ''),
                (string)($argv[3] ?? 'user')
            );
            break;

        case 'rate-level':
            rateLevel(
                $pdo,
                (int)($argv[2] ?? 0),
                (int)($argv[3] ?? 0),
                (int)($argv[4] ?? 0),
                (int)($argv[5] ?? 0),
                (int)($argv[6] ?? 0)
            );
            break;

        case 'list-levels':
            listLevels($pdo);
            break;

        default:
            echo "=== MuchoCore Admin CLI ===\n";
            echo "Commands:\n";
            echo "  mucho-admin set-role <username> <user|moderator|elder_moderator|owner>\n";
            echo "  mucho-admin set-password <username> <new_password>\n";
            echo "  mucho-admin rate-level <level_id> <stars> [featured:0/1] [epic:0-3] [demon:1-6]\n";
            echo "  mucho-admin list-levels\n";
            exit(1);
    }
} catch (Throwable $e) {
    fwrite(STDERR, "ERROR: " . $e->getMessage() . PHP_EOL);
    exit(1);
}
