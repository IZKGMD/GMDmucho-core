Options -Indexes
DirectoryIndex public/index.php

RewriteEngine On

# Never expose project internals.
RewriteRule ^(?:\.git|config|src|tests|tools|vendor|storage)(?:/|$) - [F,L,NC]

# IMPORTANT: /database is intentionally NOT blocked here.
# When the domain points to the project root, it is rewritten to
# public/database so Geometry Dash legacy endpoints remain reachable.

RewriteRule ^\.env(?:\.|$) - [F,L,NC]
RewriteRule ^composer\.(json|lock)$ - [F,L,NC]

# The browser installer lives inside public/ so the same repository works
# whether the hosting panel points the domain to the project root or public/.
RewriteRule ^shared-install\.php$ public/shared-install.php [END]

# Serve the public directory as the website root.
# NOTE: uses [L] (not [END]) so mod_rewrite restarts matching against
# public/.htaccess, which routes everything through public/index.php.
RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
RewriteRule ^(.*)$ public/$1 [L]
