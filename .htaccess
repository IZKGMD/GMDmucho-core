Options -Indexes
DirectoryIndex public/index.php

RewriteEngine On

# Never expose project internals.
RewriteRule ^(?:\.git|config|src|tests|tools|vendor|storage)(?:/|$) - [F,L,NC]

# IMPORTANT: /database is intentionally NOT blocked here.
# When the domain points to the project root, it is rewritten to
# public/database so Geometry Dash legacy endpoints remain reachable.

RewriteRule ^\.env(?:\.|$) - [F,L,NC]
RewriteRule ^composer\.(json|lock)$ - [F,L,NC]


RewriteRule ^clients(?:/)?$ public/clients.php [L]

# Serve the public directory as the website root.
# [L] keeps this compatible with standard Apache configurations.
RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
RewriteRule ^(.*)$ public/$1 [L]
